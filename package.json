    "db:inspect-security": "tsx scripts/inspect-db-security.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "6.31.9",
    "@prisma/adapter-pg": "6.16.2",
    "@prisma/client": "6.16.2",
