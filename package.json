    "next-intl": "^4.14.7",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "dotenv": "16.6.1",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "tinyexec": "1.3.1"
  }
