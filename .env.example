# Runtime URL: the non-owner pravi_app login through Supavisor's shared pooler.
# Use the exact host and username shape provided by Supabase for the project.
DATABASE_URL="postgresql://pravi_app.PROJECT_REF:RUNTIME_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Privileged direct URL: local/CI migrations and explicit administrative seeding only.
DIRECT_URL="postgresql://postgres:ADMIN_PASSWORD@DB_HOST:5432/postgres"

# Clerk keys are set in local .env.local and Vercel project settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional Clerk user IDs for provisioning synthetic demo roles during seeding.
DEMO_SUBMITTER_CLERK_USER_ID=
DEMO_VERIFIER_CLERK_USER_ID=
DEMO_INSPECTOR_CLERK_USER_ID=
DEMO_MAINTENANCE_CLERK_USER_ID=
DEMO_PLANNER_CLERK_USER_ID=
